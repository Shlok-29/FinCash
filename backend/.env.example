# Render Backend Environment Variables (Node.js Express)
# Set these in your Render Web Service -> Environment Variables

PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fincash?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=https://your-frontend.vercel.app
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
